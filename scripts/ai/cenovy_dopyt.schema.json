{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/tools/ai/cenovy-dopyt.schema.json",
  "title": "Vstup pre vyhľadanie cien (ADR-0024)",
  "description": "Nástrojový formát, nie kontrakt EOS. Obsahuje iba položky materiálu a dodávateľov; zákazník, zákazka ani výkresy sem nepatria (ADR-0024 bod 6).",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "suppliers"],
  "properties": {
    "formatVersion": {"const": "0.1.0"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 300},
          "quantity": {"type": "number", "exclusiveMinimum": 0},
          "unit": {"type": "string", "minLength": 1, "maxLength": 20}
        }
      }
    },
    "suppliers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "domain"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,60}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "domain": {
            "description": "Holá doména bez schémy, voliteľne s cestou, napr. shop.example.com alebo example.com/sk.",
            "type": "string",
            "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}(/[A-Za-z0-9._~/-]*)?$"
          }
        }
      }
    }
  }
}
