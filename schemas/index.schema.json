{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/index.schema.json",
  "title": "EOS Schema Index",
  "description": "Central schema index for EOS foundation data contracts.",
  "type": "object",
  "$defs": {
    "metadata": { "$ref": "https://eos.local/schemas/common/metadata.schema.json" },
    "sourceLink": { "$ref": "https://eos.local/schemas/common/source-link.schema.json" },
    "sourceReference": { "$ref": "https://eos.local/schemas/source-reference.schema.json" },
    "normReference": { "$ref": "https://eos.local/schemas/norm-reference.schema.json" },
    "documentRecord": { "$ref": "https://eos.local/schemas/document-record.schema.json" },
    "quantity": { "$ref": "https://eos.local/schemas/knowledge-core/quantity.schema.json" },
    "valueRange": { "$ref": "https://eos.local/schemas/knowledge-core/value-range.schema.json" },
    "measurementQuality": { "$ref": "https://eos.local/schemas/knowledge-core/measurement-quality.schema.json" },
    "condition": { "$ref": "https://eos.local/schemas/knowledge-core/condition.schema.json" },
    "classification": { "$ref": "https://eos.local/schemas/knowledge-core/classification.schema.json" },
    "propertyRecord": { "$ref": "https://eos.local/schemas/knowledge-core/property-record.schema.json" },
    "observation": { "$ref": "https://eos.local/schemas/knowledge-core/observation.schema.json" },
    "unitCatalogEntry": { "$ref": "https://eos.local/schemas/catalogs/unit-catalog-entry.schema.json" },
    "conditionTypeCatalogEntry": { "$ref": "https://eos.local/schemas/catalogs/condition-type-catalog-entry.schema.json" },
    "propertyCatalogEntry": { "$ref": "https://eos.local/schemas/catalogs/property-catalog-entry.schema.json" },
    "classificationCatalogEntry": { "$ref": "https://eos.local/schemas/catalogs/classification-catalog-entry.schema.json" }
  },
  "properties": {
    "sourceReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceReference" }
    },
    "normReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/normReference" }
    },
    "documentRecords": {
      "type": "array",
      "items": { "$ref": "#/$defs/documentRecord" }
    },
    "quantities": {
      "type": "array",
      "items": { "$ref": "#/$defs/quantity" }
    },
    "valueRanges": {
      "type": "array",
      "items": { "$ref": "#/$defs/valueRange" }
    },
    "measurementQualities": {
      "type": "array",
      "items": { "$ref": "#/$defs/measurementQuality" }
    },
    "conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "classifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/classification" }
    },
    "propertyRecords": {
      "type": "array",
      "items": { "$ref": "#/$defs/propertyRecord" }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "unitCatalogEntries": {
      "type": "array",
      "items": { "$ref": "#/$defs/unitCatalogEntry" }
    },
    "conditionTypeCatalogEntries": {
      "type": "array",
      "items": { "$ref": "#/$defs/conditionTypeCatalogEntry" }
    },
    "propertyCatalogEntries": {
      "type": "array",
      "items": { "$ref": "#/$defs/propertyCatalogEntry" }
    },
    "classificationCatalogEntries": {
      "type": "array",
      "items": { "$ref": "#/$defs/classificationCatalogEntry" }
    }
  },
  "additionalProperties": false
}
