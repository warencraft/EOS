{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/norm-reference.schema.json",
  "title": "EOS NormReference",
  "description": "Reference to an external norm, standard, or binding technical regulation. Full normative text is not allowed.",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "recordVersion",
    "revision",
    "status",
    "createdAt",
    "createdBy",
    "updatedAt",
    "updatedBy",
    "sourceLinks",
    "changeSummary",
    "officialDesignation",
    "title",
    "issuingOrganization",
    "scopeInEos"
  ],
  "properties": {
    "id": { "$ref": "https://eos.local/schemas/common/identifiers.schema.json#/$defs/NRM" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "recordVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "revision": { "type": "integer", "minimum": 0 },
    "status": { "$ref": "https://eos.local/schemas/common/lifecycle-status.schema.json#/$defs/RecordStatus" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string", "minLength": 1 },
    "sourceLinks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://eos.local/schemas/common/source-link.schema.json" }
    },
    "changeSummary": { "type": "string", "minLength": 1 },
    "replaces": { "type": "string", "minLength": 1 },
    "replacedBy": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "officialDesignation": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "editionOrYear": { "type": "string", "minLength": 1 },
    "issuingOrganization": { "type": "string", "minLength": 1 },
    "validityStatus": {
      "type": "string",
      "enum": ["KnownValid", "KnownWithdrawn", "Unknown", "Superseded"]
    },
    "scopeInEos": { "type": "string", "minLength": 1 },
    "fullTextStored": { "type": "boolean", "const": false }
  },
  "additionalProperties": false
}

