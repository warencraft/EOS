{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/document-record.schema.json",
  "title": "EOS DocumentRecord",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "recordVersion",
    "revision",
    "status",
    "createdAt",
    "createdBy",
    "updatedAt",
    "updatedBy",
    "sourceLinks",
    "changeSummary",
    "title",
    "filePath",
    "documentType",
    "documentVersion",
    "documentRevision",
    "documentStatus",
    "author",
    "lastUpdate",
    "documentBasis"
  ],
  "properties": {
    "id": { "$ref": "https://eos.local/schemas/common/identifiers.schema.json#/$defs/DOCUMENT_ID" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "recordVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "revision": { "type": "integer", "minimum": 0 },
    "status": { "$ref": "https://eos.local/schemas/common/lifecycle-status.schema.json#/$defs/RecordStatus" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string", "minLength": 1 },
    "sourceLinks": {
      "type": "array",
      "items": { "$ref": "https://eos.local/schemas/common/source-link.schema.json" }
    },
    "changeSummary": { "type": "string", "minLength": 1 },
    "replaces": { "type": "string", "minLength": 1 },
    "replacedBy": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "filePath": { "type": "string", "minLength": 1 },
    "documentType": {
      "type": "string",
      "enum": ["governance", "methodology", "internalStandard", "template", "adr", "manual", "other"]
    },
    "documentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "documentRevision": { "type": "integer", "minimum": 0 },
    "documentStatus": { "$ref": "https://eos.local/schemas/common/lifecycle-status.schema.json#/$defs/DocumentStatus" },
    "author": { "type": "string", "minLength": 1 },
    "lastUpdate": { "type": "string", "format": "date" },
    "documentBasis": { "type": "string", "minLength": 1 },
    "relatedDocumentIds": {
      "type": "array",
      "items": { "$ref": "https://eos.local/schemas/common/identifiers.schema.json#/$defs/DOCUMENT_ID" }
    },
    "relatedAdrIds": {
      "type": "array",
      "items": { "$ref": "https://eos.local/schemas/common/identifiers.schema.json#/$defs/ADR" }
    }
  },
  "additionalProperties": false
}

